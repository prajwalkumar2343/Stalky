# ----------------------------------------------------------------------------
# Stalky backend environment template.
#
# Copy to a local, untracked file (Docker Compose / shell / systemd) and fill
# in real values. Nothing in this file is secret by design; see backend/README.md
# "Production security boundary".
#
#   cp backend/.env.example backend/.env
#   set -a; source backend/.env; set +a
# ----------------------------------------------------------------------------

# Required. Base URL of the Supabase project, without a trailing slash.
# Example: https://abcdefghijklmnopqrst.supabase.co
# The backend only accepts HTTPS unless the host is localhost/127.0.0.1.
SUPABASE_URL=

# Optional. Socket address the backend binds to. Inside Docker the default in
# the image is 0.0.0.0:8080; locally the process default is 127.0.0.1:8080.
BIND_ADDRESS=127.0.0.1:8080

# Optional. tracing filter: error|warn|info|debug|trace, optionally per-crate
# (e.g. info,stalky_backend=debug). Production recommendation: info.
RUST_LOG=info
